{
  "name": "sammelband",
  "version": "0.1.0",
  "description": "Self-hosted photo books for families and friends",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:frontend": "bun run --cwd frontend dev",
    "build:frontend": "bun run --cwd frontend build",
    "build": "bun run build:frontend",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:postgres": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:test@localhost:55432/sammelband_test} bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.6.13",
    "hono": "4.13.9",
    "kysely": "0.28.17",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
