{
  "name": "sammelband",
  "version": "0.1.0",
  "description": "Self-hosted block-based photo journal",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.7.0",
    "better-auth": "^1.2.0",
    "elysia": "^1.2.0",
    "kysely": "~0.28.17",
    "lit": "^3.2.0",
    "nodemailer": "^6.9.16",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
