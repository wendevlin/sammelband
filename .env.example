PORT=3000
NODE_ENV=development

DATABASE_PATH=./sammelband.db
UPLOADS_PATH=./uploads

# Must be a random 64-char hex string in production; better-auth signs sessions with this.
SECRET_KEY=dev-secret-not-for-production-change-me

# Base URL of the deployment (used in magic link / reset emails and CSRF allowlist).
BASE_URL=http://localhost:3000

# Extra origins better-auth trusts for sign-in/sign-up etc. (comma-separated).
# BASE_URL is always trusted; in dev the Vite server at :5173 is trusted automatically.
# Set this only when the SPA is hosted on a different origin than the API in prod.
# TRUSTED_ORIGINS=https://app.example.com

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sammelband@example.com
SMTP_PASS=
SMTP_FROM="Sammelband <sammelband@example.com>"
