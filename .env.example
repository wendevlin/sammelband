PORT=3000
# docker compose only: host port for the container (which always listens on 3000).
# HOST_PORT=8080
# docker compose only: image tag (latest, beta, nightly or a version such as 0.1.0).
# SAMMELBAND_TAG=beta
NODE_ENV=development

# SQLite file. Set DATABASE_URL instead to use PostgreSQL.
DATABASE_PATH=./sammelband.db
# DATABASE_URL=postgres://sammelband:secret@localhost:5432/sammelband
UPLOADS_PATH=./uploads
# Built SvelteKit SPA served by the backend.
FRONTEND_DIST=./dist/frontend

# Must be a random 64-char hex string in production; better-auth signs sessions with this.
# e.g. openssl rand -hex 32
SECRET_KEY=dev-secret-not-for-production-change-me

# Public URL of the deployment (CSRF allowlist, onboarding link).
BASE_URL=http://localhost:3000

# Behind a reverse proxy that sets X-Forwarded-For: use it for rate limiting.
# Leave off when the app is reachable directly, or limits can be bypassed.
# TRUST_PROXY=true

# Host several independent Sammelbände (e.g. one per family) on this instance.
# MULTI_TENANT=true

# Largest accepted photo upload in MB.
# MAX_UPLOAD_MB=50

# Extra trusted origins (comma-separated). In dev the Vite server at :5173 is
# trusted automatically. Only needed when the SPA is served from another origin.
# TRUSTED_ORIGINS=https://app.example.com
