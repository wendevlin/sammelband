PORT=3000
NODE_ENV=development

DATABASE_PATH=./sammelband.db
UPLOADS_PATH=./uploads
# Built SvelteKit SPA served by the backend.
FRONTEND_DIST=./dist/frontend

# Must be a random 64-char hex string in production; better-auth signs sessions with this.
# e.g. openssl rand -hex 32
SECRET_KEY=dev-secret-not-for-production-change-me

# Public URL of the deployment (CSRF allowlist, onboarding link).
BASE_URL=http://localhost:3000

# Extra trusted origins (comma-separated). In dev the Vite server at :5173 is
# trusted automatically. Only needed when the SPA is served from another origin.
# TRUSTED_ORIGINS=https://app.example.com
